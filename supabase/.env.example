# Contoh env untuk backend Supabase. JANGAN isi values asli di sini.
# SUPABASE_URL / ANON_KEY / SERVICE_ROLE_KEY otomatis tersedia di Edge Function
# (reserved, tidak bisa di-set via `supabase secrets set`). File ini hanya
# dokumentasi + dipakai bila perlu client manual di luar function.
# Lokal (supabase start) memakai values bawaan, tidak perlu file ini.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-RAHASIA-server-saja>
