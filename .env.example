# Contoh konfigurasi environment Pandu.
# Salin ke `.env` untuk development lokal:  cp .env.example .env
# JANGAN commit file `.env` yang berisi secrets (sudah di-gitignore).
#
# Base URL backend API (tanpa trailing slash). Contoh lokal: http://localhost:3000
# - Saat diisi: request langsung ke backend tersebut.
# - Saat kosong: request memakai path relatif (/api/...) yang di-proxy vite (dev)
#   atau diserve satu domain dengan backend (production monorepo).
VITE_API_URL=
